# Pinned versions and addresses of the local k3s + Kube-OVN lab (hack/dev-cluster.sh).
K3S_VERSION=v1.35.9+k3s1        # newest 1.35: Kube-OVN v1.16.2 is tested on Kubernetes 1.35
KUBE_OVN_VERSION=v1.16.2        # the hv-01 lab's version
MULTUS_VERSION=v4.2.4           # what Kube-OVN v1.16.2's kind e2e installs
LAB_NAME=ovn-topo               # VM names: ovn-topo-server, ovn-topo-agent1, ovn-topo-agent2
LAB_TOKEN=kvovn-topo-lab-token
EGRESS_GATEWAY=192.168.107.1   # egress0 (dummy NIC) carries the NAT scenarios' external subnets
EGRESS_CIDR=192.168.107.0/24
